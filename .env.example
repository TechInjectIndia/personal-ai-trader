# Helm — environment template.
# Copy to `.env` and fill in. NEVER commit `.env`.

# --- Zerodha — Kite Connect (https://developers.kite.trade) ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=                                         # set daily via scripts/kite_login.py
KITE_REDIRECT_URL=https://your-domain.example.com/auth/kite/callback
ZERODHA_CLIENT_ID=

# --- IBKR — IB Gateway / TWS ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497           # 7497 = paper, 7496 = live
IBKR_CLIENT_ID=99
IBKR_PAPER_USER=
IBKR_PAPER_PASS=

# --- Notifications (Phase 6) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
